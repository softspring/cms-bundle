{% trans_default_domain 'sfs_cms_admin' %}

{% embed '@SfsCms/admin/_embeds/_card.html.twig' with {'title': ('admin_sections.version_info.compiled.title')|trans} %}
    {% trans_default_domain 'sfs_cms_admin' %}

    {% block title %}
        {% if sfs_cms_admin_section_recompile_enabled %}
            {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_RECOMPILE', version_entity) %}
                <a class="mx-1 btn btn-sm btn-outline-secondary float-end"
                   href="{{ url('sfs_cms_admin_sections_recompile_version', {'section':section_entity.id, 'version': version_entity.id, 'back': 'version_info'}) }}">{{ ('admin_sections.version_info.actions.recompile.link')|trans }}</a>
            {% else %}
                <a class="mx-1 btn btn-sm btn-outline-secondary float-end disabled">{{ ('admin_sections.version_info.actions.recompile.link')|trans }}</a>
            {% endif %}
        {% endif %}

        {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_CLEAR_COMPILED', version_entity) %}
            <a class="mx-1 btn btn-sm btn-outline-secondary float-end"
               href="{{ url('sfs_cms_admin_sections_clear_compiled_version', {'section':section_entity.id, 'version': version_entity.id, 'back': 'version_info'}) }}">{{ ('admin_sections.version_info.actions.clear_compiled.link')|trans }}</a>
        {% else %}
            <a class="mx-1 btn btn-sm btn-outline-secondary float-end disabled">{{ ('admin_sections.version_info.actions.clear_compiled.link')|trans }}</a>
        {% endif %}

        {{ parent() }}
    {% endblock %}

    {% block content %}
        {% import '@SfsCms/admin/content/_macros.html.twig' as tools %}

        {% if version.hasCompileErrors %}
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle text-danger"
                   title="This version has some compilation error"></i>
                {{ ('admin_sections.version_info.compiled.error')|trans }}
            </div>
        {% else %}
            {% if not (section_can_be_compiled|default(true)) %}
                <div class="alert alert-warning" role="alert">
                    {{ ('admin_sections.version_info.compiled.pre_compile_section_disabled')|trans }}
                </div>
            {% elseif version_entity.compiled is empty and sfs_cms_admin_section_recompile_enabled %}
                <div class="alert alert-warning" role="alert">
                    {{ ('admin_sections.version_info.compiled.pre_compile_section_missing')|trans }}
                </div>
            {% endif %}

            {% if not section_can_compile_modules %}
                <div class="alert alert-warning" role="alert">
                    {{ ('admin_sections.version_info.compiled.pre_compile_modules_disabled')|trans }}
                </div>
            {% elseif version_entity.compiled is empty and sfs_cms_admin_section_recompile_enabled %}
                <div class="alert alert-danger" role="alert">
                    {{ ('admin_sections.version_info.compiled.pre_compile_modules_missing')|trans }}
                </div>
            {% endif %}
        {% endif %}

        <div class="accordion" id="accordionCompiled">
            <div class="accordion-item">
                {% set first = false %}
                {% for compiled in version_entity.compiled|filter((compiled)=>compiled.dataPart('content')|default(false)) %}
                    {% set keyCleaned = compiled.key|replace({'/': '', ' ': '', '.' : ''}) %}
                    <h2 class="accordion-header" id="heading{{ keyCleaned }}">
                        <button class="accordion-button {{ first?'':'collapsed' }}" type="button"
                                data-bs-toggle="collapse" data-bs-target="#collapse{{ keyCleaned }}"
                                aria-expanded="{{ first?'true':'false' }}"
                                aria-controls="collapse{{ keyCleaned }}">
                            Pre-compiled section {{ compiled.key }}
                            {% if compiled.hasErrors %}
                                <i class="ms-2 bi bi-exclamation-circle text-danger" title="{{ ('admin_sections.version_info.compiled.pre_compile_section_info')|trans }}"></i>
                            {% endif %}
                        </button>
                    </h2>
                    <div id="collapse{{ keyCleaned }}"
                         class="accordion-collapse collapse {{ first?'show':'' }}"
                         aria-labelledby="heading{{ keyCleaned }}" data-bs-parent="#accordionCompiled">
                        <div class="accordion-body">
                            {% if compiled is not iterable %}
                                {{ tools.drawEsiCalls(compiled.dataPart('content')) }}
                                <pre class="overflow-auto" style="max-height: 600px"><code class="text-muted">{{ compiled.dataPart('content') }}</code>{#<code class="text-danger">{{ compiled.dataPart('errors')|default(false) }}</code>#}
{% if compiled.dataPart('errors') %}<code class="text-danger">{{ compiled.dataPart('errors')|json_encode(128) }}</code>{% endif %}</pre>
                            {% endif %}
                        </div>
                    </div>
                    {% set first = false %}
                {% endfor %}

                {% for compiled in version_entity.compiled|filter((compiled)=>compiled.dataPart('containers')|default(false)) %}
                    {% set keyCleaned = ('containers'~compiled.key)|replace({'/': '', ' ': '', '.': ''}) %}
                    <h2 class="accordion-header" id="heading{{ keyCleaned }}">
                        <button class="accordion-button {{ first?'':'collapsed' }}" type="button"
                                data-bs-toggle="collapse" data-bs-target="#collapse{{ keyCleaned }}"
                                aria-expanded="{{ first?'true':'false' }}"
                                aria-controls="collapse{{ keyCleaned }}">
                            Pre-compiled containers {{ compiled.key }}
                        </button>
                    </h2>
                    <div id="collapse{{ keyCleaned }}"
                         class="accordion-collapse collapse {{ first?'show':'' }}"
                         aria-labelledby="heading{{ keyCleaned }}" data-bs-parent="#accordionCompiled">
                        <div class="accordion-body">
                            {% for container, section in compiled.dataPart('containers') %}
                                <strong>{{ container }}</strong>
                                {{ tools.drawEsiCalls(section) }}
                                <pre class="overflow-auto"
                                     style="max-height: 300px"><code class="text-muted">{{ section }}</code></pre>
                            {% endfor %}
                        </div>
                    </div>
                    {% set first = false %}
                {% endfor %}
            </div>
        </div>
    {% endblock %}
{% endembed %}
