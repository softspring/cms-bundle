{
    "name": "softspring/cms-bundle",
    "description": "A cms bundle",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-zip": "*",
        "ext-libxml": "*",
        "doctrine/collections": "^1.8 | ^2.0",
        "doctrine/doctrine-bundle": "^2.6",
        "doctrine/migrations": "^3.2",
        "doctrine/orm": "^2.14 | ^3.0",
        "softspring/components": "^5.4@dev",
        "softspring/crudl-controller": "^5.4@dev",
        "softspring/doctrine-migrations-version-comparator": "^5.4@dev",
        "softspring/doctrine-target-entity-resolver": "^5.4@dev",
        "softspring/dynamic-form-type": "^5.4@dev",
        "softspring/events": "^5.4@dev",
        "softspring/media-bundle": "^5.4@dev",
        "softspring/permissions-bundle": "^5.4@dev",
        "softspring/polymorphic-form-type": "^5.4@dev",
        "softspring/translatable-bundle": "^5.4@dev",
        "softspring/twig-extra-bundle": "^5.4@dev",
        "symfony/config": "^5.4|^6.0|^7.0",
        "symfony/intl": "^5.4|^6.0|^7.0",
        "symfony/routing": "^5.4|^6.0|^7.0",
        "symfony/serializer": "^5.4|^6.0|^7.0",
        "symfony/uid": "^5.4|^6.0|^7.0",
        "symfony/validator": "^6.2|^7.0",
        "symfony/yaml": "^5.4|^6.0|^7.0",
        "twig/twig": "^2.10|^3.0"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^1.6 || ^2.0",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "friendsofphp/php-cs-fixer": "^3.68",
        "google/cloud-storage": "^1.30",
        "phpstan/phpstan": "^1.12.3",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^1.0",
        "sensio/framework-extra-bundle": "^5.4|^6.2",
        "softspring/user-bundle": "^5.2",
        "symfony/css-selector": "^5.4|^6.0|^7.0",
        "symfony/dom-crawler": "^5.4|^6.0|^7.0",
        "symfony/form": "^6.4|^7.0",
        "symfony/maker-bundle": "^1.38",
        "symfony/web-profiler-bundle": "^5.4|^6.0|^7.0",
        "symfony/webpack-encore-bundle": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CmsBundle\\": "src"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CmsBundle\\Test\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    }
}
