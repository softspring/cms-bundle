{% trans_default_domain 'sfs_cms_contents' %}

{% embed '@SfsCms/admin/_embeds/_card.html.twig' with {'title': 'General'} %}
    {% trans_default_domain 'sfs_cms_contents' %}

    {% block title %}
        {% if entity.publishedVersion %}
            {% if not content_config.admin.unpublish.is_granted or is_granted(content_config.admin.unpublish.is_granted, entity) %}
                <a class="btn btn-sm btn-outline-secondary float-end"  href="{{ url('sfs_cms_admin_content_'~content_type~'_unpublish', {'content':entity.id}) }}"
                   data-confirm-modal="{{ ('admin_'~content_type~'.unpublish.confirm_message_raw')|trans|base64_encode }}"
                   data-confirm-modal-title="{{ ('admin_'~content_type~'.unpublish.confirm_message_title')|trans }}"
                   data-confirm-modal-confirm-button-type="danger"
                >{{ ('admin_'~content_type~'.read.actions.unpublish.link')|trans }} <i class="bi bi-toggle-off"></i></a>
            {% else %}
                <a class="btn btn-sm btn-outline-secondary float-end disabled">{{ ('admin_'~content_type~'.read.actions.unpublish.link')|trans }} <i class="bi bi-toggle-off"></i></a>
            {% endif %}
        {% endif %}
        {{ parent() }}
    {% endblock %}

    {% block content %}
        <dl class="mb-0">
            {#<dt class=fw-normal>{{ ('admin_'~content_type~'.read.name')|trans }}</dt>#}
            {#<dd class=fw-bold>{{ entity.name }}</dd>#}
            <dt class="fw-normal">{{ ('admin_'~content_type~'.read.sites')|trans }}</dt>
            <dd class="fw-bold">{{ entity.sites|map((site) => site|sfs_cms_site_name)|join(', ') }}</dd>
            <dt class="fw-normal">{{ ('admin_'~content_type~'.read.general.status')|trans }}</dt>
            <dd class="fw-bold">
                {{ (content_type~'.status.'~entity.status)|trans }}
                {% if entity.publishedVersion %}
                    (<a href="{{ url('sfs_cms_admin_content_'~content_type~'_version_info', {'content':entity.id, 'version':entity.publishedVersion.id}) }}">v{{ entity.publishedVersion.versionNumber }}</a>)
                {% endif %}
            </dd>
            {% if entity.publishedVersion %}
            <dt class="fw-normal">{{ ('admin_'~content_type~'.read.general.publishDate')|trans }}</dt>
            <dd class="fw-bold">
                {% if entity.lastModified %}
                    {{ entity.lastModified|date('H:i d-m-Y') }}
                {% endif %}
            </dd>
            {% endif %}
        </dl>
    {% endblock %}
{% endembed %}