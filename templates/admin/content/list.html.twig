{% trans_default_domain 'sfs_cms_contents' %}
{% extends '@SfsCms/admin_layout.html.twig' %}
{% form_theme filterForm '@SfsComponents/forms/admin-horizontal.html.twig' %}

{% block title %}{{ ('admin_'~content_type~'.list.meta.title')|trans }}{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ ('admin_'~content_type~'.list.breadcrumb')|trans }}</li>
{% endblock breadcrums_content %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3">{{ ('admin_'~content_type~'.list.title')|trans }}</h1>

        <div class="d-flex flex-wrap justify-items-end alig-items-center">
            {% if not content_config.admin.create.is_granted or is_granted(content_config.admin.create.is_granted) %}
                <a class="btn btn-primary ms-3 mb-2" href="{{ url('sfs_cms_admin_content_'~content_type~'_create') }}">{{ ('admin_'~content_type~'.list.actions.create.link')|trans }} <i class="bi bi-plus-circle"></i></a>
            {% endif %}

            {% if route_defined('sfs_cms_admin_content_'~content_type~'_import') %}
                {# TODO make this configurable and extensible for plugins #}
                {% if not content_config.admin.import.is_granted or is_granted(content_config.admin.import.is_granted) %}
                    <a class="btn btn-outline-primary ms-3 mb-2" href="{{ url('sfs_cms_admin_content_'~content_type~'_import') }}">{{ ('admin_'~content_type~'.list.actions.import.link')|trans }} <i class="bi bi-cloud-upload"></i></a>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <div class="container-fluid bg-white p-4">
        {% if filterForm.vars.submitted or entities|length %}
            <div class="mb-4">
                {{ form_start(filterForm) }}
                <div class="d-flex flex-wrap align-items-center gap-3">
                    {% if filterForm.name is defined %}{{ form_row(filterForm.name, {'row_class':'form-floating mb-3'}) }}{% endif %}
                    {% if filterForm.sites is defined %}{{ form_row(filterForm.sites, {'row_class':'form-floating mb-3', 'attr':{'onchange':'submit()'}}) }}{% endif %}
                    {% if filterForm.status is defined %}{{ form_row(filterForm.status, {'row_class':'form-floating mb-3', 'attr':{'onchange':'submit()'}}) }}{% endif %}
                    {% if filterForm.publishedVersionContent is defined %}{{ form_row(filterForm.publishedVersionContent, {'row_class':'form-floating mb-3', 'attr':{'onchange':'submit()'}}) }}{% endif %}
                    <div class="align-self-end pb-3">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                    </div>
                </div>
                {{ form_widget(filterForm) }}
                {{ form_rest(filterForm) }}
                {{ form_end(filterForm) }}
            </div>
        {% endif %}

        {% block table %}
            {% embed '@SfsComponents/paginator/table.html.twig' with {'collection':entities, 'filterForm': filterForm, 'pagination_route': 'sfs_cms_admin_content_'~content_type~'_list', 'content_type': content_type, 'list_page_view': list_page_view, 'content_config': content_config} only %}
                {% trans_default_domain 'sfs_cms_contents' %}
                {% block ths %}
                    <th scope="col">
                        <a href="{{ collection.sortToggleUrl(app.request, 'name') }}" class="text-dark">
                            {{ ('admin_'~content_type~'.list.fields.name.header')|trans }}
                            {% if collection.sortedBy('name', 'asc') %}<i class="bi bi-caret-up-fill"></i>{% elseif collection.sortedBy('name', 'desc') %}<i class="bi bi-caret-down-fill"></i>{% endif %}
                        </a>
                    </th>
                    <th class="">{{ ('admin_'~content_type~'.list.fields.site.header')|trans }}</th>
                    <th class="">{{ ('admin_'~content_type~'.list.fields.status.header')|trans }}</th>
                    <th class="">{{ ('admin_'~content_type~'.list.fields.publishedAt.header')|trans }}</th>
                    <th class="">&nbsp;</th>
                {% endblock ths %}

                {% block tbody %}
                    {% include list_page_view %}
                {% endblock tbody %}

                {% block empty_message %}
                    {% if filterForm|default(false) and filterForm.vars.data|default([])|filter(v=>v) is not empty %}
                        <div class="p-5 text-center">
                            <p class="mb-3 text-body-secondary">
                                {{ ('admin_'~content_type~'.list.empty.clean_filters')|trans({'%url%': url('sfs_cms_admin_content_'~content_type~'_list')})|raw }}
                            </p>
                        </div>
                    {% else %}
                        <div class="p-5 text-center">
                            <p class="mb-3 text-body-secondary">
                                {% if not content_config.admin.create.is_granted or is_granted(content_config.admin.create.is_granted) %}
                                    {{ ('admin_'~content_type~'.list.empty.create_first_content_raw')|trans({
                                        '%create_link%': url('sfs_cms_admin_content_'~content_type~'_create'),
                                        '%import_link%': url('sfs_cms_admin_content_'~content_type~'_import'),
                                    })|raw }}
                                {% else %}
                                    {{ ('admin_'~content_type~'.list.empty.can_not_create_content')|trans }}
                                {% endif %}
                            </p>
                            <p class="mb-0 text-body-secondary">
                                {{ ('admin_'~content_type~'.list.empty.go_to_doc_raw')|trans|raw }}
                            </p>
                        </div>
                    {% endif %}
                {% endblock empty_message %}
            {% endembed %}
        {% endblock table %}
    </div>
{% endblock content %}
