{% trans_default_domain 'sfs_cms_contents' %}

{% extends '@SfsCms/admin_layout.html.twig' %}

{% form_theme form
    '@SfsCms/forms/cms_theme.html.twig'
    '@SfsCms/forms/routes_theme.html.twig'
    '@SfsCms/forms/types_theme.html.twig'
%}

{% block title %}{{ ('admin_'~content_type~'.update.meta.title')|trans({'%name%':entity.name}) }}{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item"><a href="{{ url('sfs_cms_admin_content_'~content_type~'_list') }}">{{ ('admin_'~content_type~'.list.breadcrumb')|trans }}</a></li>
    <li class="breadcrumb-item"><a href="{{ url('sfs_cms_admin_content_'~content_type~'_details', {'content':entity.id}) }}">{{ ('admin_'~content_type~'.read.breadcrumb')|trans({'%name%': entity.name}) }}</a></li>
    <li class="breadcrumb-item active" aria-current="content">{{ ('admin_'~content_type~'.update.breadcrumb')|trans({'%name%':entity.name}) }}</li>
{% endblock breadcrums_content %}

{% block content %}
    {% include ['@content/'~content_type~'/admin/_content_title.html.twig', '@SfsCms/admin/content/_content_title.html.twig']  with {'current':'update', 'content_type':content_type, 'content_entity':entity} %}
    {% include ['@content/'~content_type~'/admin/_content_tabs.html.twig', '@SfsCms/admin/content/_content_tabs.html.twig']  with {'current':'update', 'content':content, 'content_entity':entity} %}

    {{ form_start(form) }}

    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="edit" role="tabpanel" aria-labelledby="edit-tab">
            <div class="container-fluid bg-white p-3">
                {% block form_fields %}
                    {% include [
                        '@content/'~content_type~'/admin/_form_fields.html.twig',
                        '@SfsCms/admin/content/_form_fields.html.twig'
                    ] with {
                        form: form,
                        content_type: content_type,
                        routes_enabled: false,
                    } only %}
                {% endblock %}

                <div class="d-flex justify-content-end align-items-center">
                    <a href="{{ url('sfs_cms_admin_content_'~content_type~'_details', {'content':entity.id}) }}" class="btn btn-outline-secondary ms-3">{{ ('admin_'~content_type~'.update.actions.cancel.button')|trans }}</a>
                    <input type="submit" value="{{ ('admin_'~content_type~'.update.actions.update.button')|trans }}" class="btn btn-primary ms-3" />
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock content %}
