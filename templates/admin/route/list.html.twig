{% trans_default_domain 'sfs_cms_admin' %}
{% extends '@SfsCms/admin_layout.html.twig' %}
{% form_theme filterForm '@SfsComponents/forms/admin-horizontal.html.twig' %}

{% block title %}{{ 'admin_routes.list.meta.title'|trans }}{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="content">{{ 'admin_routes.list.breadcrumb'|trans }}</li>
{% endblock breadcrums_content %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3">{{ 'admin_routes.list.title'|trans }}</h1>

{#        #}{# TODO restrict by permission #}
        <div class="d-flex flex-wrap justify-items-end alig-items-center">
            <a class="btn btn-primary ms-3 mb-2" href="{{ url('sfs_cms_admin_routes_create') }}">{{ 'admin_routes.list.actions.create.link'|trans }} <i class="bi bi-plus-circle"></i></a>
        </div>
    </div>

    <div class="container-fluid bg-white p-4">
        {% if filterForm.vars.submitted or entities|length %}
            <div class="mb-4">
                {{ form_start(filterForm) }}
                <div class="d-flex flex-wrap align-items-center gap-3">
                    {% if filterForm.id is defined %}{{ form_row(filterForm.id, {'row_class':'form-floating mb-3'}) }}{% endif %}
                    {% if filterForm.path is defined %}{{ form_row(filterForm.path, {'row_class':'form-floating mb-3'}) }}{% endif %}
                    {% if filterForm.sites is defined %}{{ form_row(filterForm.sites, {'row_class':'form-floating mb-3', 'attr':{'onchange':'submit()'}}) }}{% endif %}
                    {% if filterForm.type is defined %}{{ form_row(filterForm.type, {'row_class':'form-floating mb-3', 'attr':{'onchange':'submit()'}}) }}{% endif %}
                    <div class="align-self-end pb-3">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                    </div>
                </div>
                {{ form_widget(filterForm) }}
                {{ form_rest(filterForm) }}
                {{ form_end(filterForm) }}
            </div>
        {% endif %}

        {% embed '@SfsComponents/paginator/table.html.twig' with {'collection':entities, 'filterForm': filterForm, 'pagination_route': 'sfs_cms_admin_routes_list'} only %}
            {% trans_default_domain 'sfs_cms_admin' %}
            {% block ths %}
                <th class="p-3" scope="col">
                    <a href="{{ collection.sortToggleUrl(app.request, 'id') }}" class="text-dark">
                        {{ 'admin_routes.list.fields.id.header'|trans }}
                        {% if collection.sortedBy('id', 'asc') %}<i class="bi bi-caret-up-fill"></i>{% elseif collection.sortedBy('id', 'desc') %}<i class="bi bi-caret-down-fill"></i>{% endif %}
                    </a>
                </th>
                <th class="p-3" scope="col">{{ 'admin_routes.list.fields.sites.header'|trans }}</th>
                <th class="p-3" scope="col">{{ 'admin_routes.list.fields.type.header'|trans }}</th>
                <th class="p-3" scope="col">{{ 'admin_routes.list.fields.content.header'|trans }}</th>
                <th class="p-3">&nbsp;</th>
            {% endblock ths %}

            {% block tbody %}
                {% include '@SfsCms/admin/route/list-page.html.twig' %}
            {% endblock tbody %}

                {% block empty_message %}
                    {% if filterForm|default(false) and filterForm.vars.data|default([])|filter(v=>v) is not empty %}
                    <div class="p-5 text-center">
                        <p class="mb-3 text-body-secondary">
                            {{ ('admin_routes.list.empty.clean_filters')|trans({'%url%': url('sfs_cms_admin_routes_list')})|raw }}
                        </p>
                    </div>
                    {% else %}
                    <div class="p-5 text-center">
                        <p class="mb-3 text-body-secondary">
                            {{ ('admin_routes.list.empty.create_first_route_raw')|trans({
                                '%create_link%': url('sfs_cms_admin_routes_create'),
                            })|raw }}
                        </p>
                        <p class="mb-0 text-body-secondary">
                            {{ ('admin_routes.list.empty.go_to_doc_raw')|trans|raw }}
                        </p>
                    </div>
                    {% endif %}
                {% endblock empty_message %}
        {% endembed %}
    </div>
{% endblock content %}
