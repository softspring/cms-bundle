<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Softspring\CmsBundle\Entity\Section" table="cms_section">
        <cache usage="NONSTRICT_READ_WRITE" />

        <id name="id" type="string" length="36" column="id">
            <options><option name="fixed">true</option></options>
            <generator strategy="CUSTOM" />
            <custom-id-generator class="doctrine.uuid_generator"/>
        </id>

        <one-to-many field="versions" target-entity="Softspring\CmsBundle\Model\SectionVersionInterface" mapped-by="section" fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
            </cascade>
            <order-by>
                <order-by-field name="createdAt" direction="DESC" />
            </order-by>
        </one-to-many>

        <many-to-one field="publishedVersion" target-entity="Softspring\CmsBundle\Model\SectionVersionInterface" fetch="LAZY">
            <join-column name="published_version_id" on-delete="SET NULL"/>
        </many-to-one>

        <many-to-one field="lastVersion" target-entity="Softspring\CmsBundle\Model\SectionVersionInterface" fetch="LAZY">
            <join-column name="last_version_id" on-delete="SET NULL"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
