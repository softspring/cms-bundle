{% trans_default_domain 'sfs_cms_contents' %}

{% extends '@SfsCms/admin_layout.html.twig' %}

{% block title %}{{ ('admin_'~content_type~'.preview.meta.title')|trans({'%name%':entity.name}) }}{% endblock %}

{% block body %}
    <div class="container-fluid p-0 vh-100 d-flex flex-column min-vh-100">
        <header class="cms-content-header flex-grow-0 d-flex flex-column flex-fill p-3 bg-dark border-bottom">
            <div class="container-fluid">
                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                    <a href="#" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none">
                        {{ ('admin_'~content_type~'.preview.title')|trans({'%name%':entity.name, '%versionNumber%': version.versionNumber}) }}
                    </a>

                    <div class="col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0"></div>

                    <div class="text-end me-3">
                        <form class="d-flex" action="{{ url('sfs_cms_admin_content_'~content_type~'_version_preview', {'content':entity.id, 'version':version.id}) }}" method="GET" target="previewFrame" id="previewForm">
                            {% if content_entity.locales|length > 1 %}
                                <select class="form-select mx-1" name="_locale" onchange="previewSubmit()">
                                    {% for locale in content_entity.locales %}
                                        <option value="{{ locale|lower }}" {% if locale == content_entity.defaultLocale %}selected{% endif %}>{{ locale|upper }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}

                            {% if entity.sites|length > 1 %}
                                <select class="form-select mx-1" name="_site" onchange="previewSubmit()">
                                    {% for site in entity.sitesSorted %}
                                        <option value="{{ site }}">{{ site|sfs_cms_site_name }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </form>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button id="previewExternalLink" class="btn btn-light mx-1" onclick="previewSubmit(true)"
                        >{{ ('admin_'~content_type~'.preview.actions.open.button')|trans }} <i class="bi bi-box-arrow-up-right"></i></button>
                        {% if app.request.query.get('back') == 'versions' %}
                            <a href="{{ url('sfs_cms_admin_content_'~content_type~'_versions', {'content':entity.id}) }}" class="btn btn-light mx-1">{{ ('admin_'~content_type~'.preview.actions.cancel.button')|trans }}</a>
                        {% else %}
                            <a href="{{ url('sfs_cms_admin_content_'~content_type~'_details', {'content':entity.id}) }}" class="btn btn-light mx-1">{{ ('admin_'~content_type~'.preview.actions.cancel.button')|trans }}</a>
                        {% endif %}

                        {% if not content_config.admin.version_create.is_granted or is_granted(content_config.admin.version_create.is_granted, version) %}
                            <a href="{{ url('sfs_cms_admin_content_'~content_type~'_content_from_version', {'content':entity.id, 'prevVersion':version.id}) }}" class="btn btn-light mx-1">{{ ('admin_'~content_type~'.preview.actions.content.button')|trans }}</a>
                        {% else %}
                            <a class="btn btn-light mx-1 disabled">{{ ('admin_'~content_type~'.preview.actions.content.button')|trans }}</a>
                        {% endif %}

                        {% if version.published %}
                            <span class="btn btn-light disabled mx-1">{{ ('admin_'~content_type~'.preview.actions.published.button')|trans }}</span>
                        {% else %}
                            {% if not content_config.admin.publish_version.is_granted or is_granted(content_config.admin.publish_version.is_granted, version) %}
                                <a href="{{ url('sfs_cms_admin_content_'~content_type~'_publish_version', {'content':entity.id, 'version':version.id, 'back':'preview'}) }}" class="btn btn-light mx-1">{{ ('admin_'~content_type~'.preview.actions.publish.button')|trans }}</a>
                            {% else %}
                                <a class="btn btn-light mx-1 disabled">{{ ('admin_'~content_type~'.preview.actions.publish.button')|trans }}</a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </header>
        <main class="position-relative flex-fill flex-grow-1 d-flex flex-column bg-light">
            <iframe class="h-100 w-100 opacity-50" name="previewFrame" id="preview" src="{{ url('sfs_cms_admin_content_'~content_type~'_version_preview', {'content':entity.id, 'version':version.id, '_site': entity.sitesSorted.first, '_locale': entity.defaultLocale}) }}" width="100%" height="100%"></iframe>
            <div class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center" id="spinner" style="pointer-events: none;">
                <div class="spinner-border" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>
        </main>
    </div>

    <script>
        const iframe = document.getElementById('preview');
        function previewSubmit(external = false) {
            if (external) {
                document.getElementById('previewForm').target = '_blank';
            }

            if (!external) {
                iframe.classList.add('opacity-50');
                document.getElementById('spinner').classList.remove('d-none');
            }

            document.getElementById('previewForm').submit(); // do the submit

            if (external) {
                document.getElementById('previewForm').target = 'previewFrame';
            }
        }
        function previewLoaded() {
            iframe.classList.remove('opacity-50');
            document.getElementById('spinner').classList.add('d-none');
        }
        iframe.onload = function() {
            previewLoaded();
        };
    </script>

    {% include '@SfsComponents/flash-messages/alerts.html.twig' %}
{% endblock body %}
