{% trans_default_domain 'sfs_cms_admin' %}

{% extends '@SfsCms/admin_layout.html.twig' %}

{% block title %}{{ ('admin_sections.versions.meta.title')|trans({'%name%':section_entity.name}) }}{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item"><a href="{{ url('sfs_cms_admin_sections_list') }}">{{ ('admin_sections.list.breadcrumb')|trans }}</a></li>
    <li class="breadcrumb-item"><a href="{{ url('sfs_cms_admin_sections_details', {'section':section_entity.id}) }}">{{ ('admin_sections.read.breadcrumb')|trans({'%name%': section_entity.name}) }}</a></li>
    <li class="breadcrumb-item active" aria-current="section">{{ ('admin_sections.versions.breadcrumb')|trans({'%name%':section_entity.name}) }}</li>
{% endblock breadcrums_content %}

{% block content %}
    {% include '@SfsCms/admin/section/_section_title.html.twig' with {'current':'versions', 'section_entity':section_entity} %}
    {% include '@SfsCms/admin/section/_section_tabs.html.twig' with {'current':'versions', 'section_entity':section_entity} %}

    <div class="container-fluid mb-3">
        <div class="row">
            <div class="col">
                <div class="float-end">
{#                    {% if false and is_granted('ROLE') %}#}
{#                        <a class="btn btn-outline-secondary" href="{{ url('sfs_cms_admin_sections_import_version', {'section':section_entity.id, 'back':'versions'}) }}">{{ ('admin_sections.versions.actions.import_version.link')|trans }}</a>#}
{#                    {% else %}#}
{#                        <a class="btn btn-outline-secondary disabled">{{ ('admin_sections.versions.actions.import_version.link')|trans }}</a>#}
{#                    {% endif %}#}

                    {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_CLEANUP_VERSIONS', section_entity) %}
                        <a class="btn btn-outline-secondary"
                           onclick="return confirm('{{ ('admin_sections.versions.actions.cleanup_versions.confirm')|trans }}');"
                           href="{{ url('sfs_cms_admin_sections_cleanup_versions', {'section':section_entity.id, 'back':'versions'}) }}">{{ ('admin_sections.versions.actions.cleanup_versions.link')|trans }}</a>
                    {% else %}
                        <a class="btn btn-outline-secondary disabled">{{ ('admin_sections.versions.actions.cleanup_versions.link')|trans }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid p-3 bg-white">
        <div class="row mt-4">
            <div class="col">
                {% include '@SfsCms/admin/section/_version_list_table.html.twig' with {'versions': entities, 'section': section_entity} %}
            </div>
        </div>
    </div>

{% endblock content %}
