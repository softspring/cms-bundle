{% trans_default_domain 'sfs_cms_contents' %}

<h5 class="border-bottom border-1 border-light pb-2 mb-3 d-flex align-items-center justify-content-between gap-2">
    <span>{{ ('admin_'~content_type~'.read.versions.title')|trans }}</span>
    {% if not content_config.admin.version_list.is_granted or is_granted(content_config.admin.version_list.is_granted, content_entity) %}
        <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="{{ url('sfs_cms_admin_content_'~content_type~'_versions', {'content':content_entity.id}) }}">{{ ('admin_'~content_type~'.read.versions.more.link')|trans }}</a>
    {% else %}
        <a class="btn btn-sm btn-outline-secondary flex-shrink-0 disabled">{{ ('admin_'~content_type~'.read.versions.more.link')|trans }}</a>
    {% endif %}
</h5>

{% include ['@content/'~content_type~'/admin/_version_list_table.html.twig', '@SfsCms/admin/content/_version_list_table.html.twig'] with {'versions': entityLatestVersions} %}
