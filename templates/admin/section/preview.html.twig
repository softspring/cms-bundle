{% trans_default_domain 'sfs_cms_admin' %}

{% extends '@SfsCms/admin_layout.html.twig' %}

{% block title %}{{ ('admin_sections.preview.meta.title')|trans({'%name%':section.name}) }}{% endblock %}

{% block body %}
    <div class="cms-content d-flex lign-items-stretch min-vh-100">
        <header class="cms-section-header flex-fill p-3 bg-dark fixed-top border-bottom">
            <div class="container-fluid">
                <div class="d-flex flex-wrap align-items-center justify-section-center justify-section-lg-start">
                    <a href="#" class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none">
                        {{ ('admin_sections.preview.title')|trans({'%name%':section.name, '%versionNumber%': version.versionNumber}) }}
                    </a>

                    <div class="col-12 col-lg-auto me-lg-auto mb-2 justify-section-center mb-md-0"></div>

                    <div class="text-end me-3">
                        <form class="d-flex" action="{{ url('sfs_cms_admin_sections_version_preview', {'section':section.id, 'version':version.id}) }}" method="GET" target="previewFrame">
                            {% if availableLocales|length > 1 %}
                                <select class="form-select mx-1" name="_locale" onchange="this.form.submit()">
                                    {% for locale in availableLocales %}
                                        <option value="{{ locale|lower }}" {% if locale == defaultLocale %}selected{% endif %}>{{ locale|upper }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}

                            {% if sites|length > 1 %}
                                <select class="form-select mx-1" name="_site" onchange="this.form.submit()">
                                    {% for site in sites %}
                                        <option value="{{ site }}">{{ site|sfs_cms_site_name }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </form>
                    </div>

                    <div class="d-flex justify-section-end">
                        <a id="previewExternalLink" target="_blank" class="btn btn-light mx-1" href="{{ url('sfs_cms_admin_sections_version_preview', {'section':section.id, 'version':version.id, '_locale':app.request.query.get('_locale', 'es')}) }}">{{ ('admin_sections.preview.actions.open.button')|trans }} <i class="bi bi-box-arrow-up-right"></i></a>
                        {% if app.request.query.get('back') == 'versions' %}
                            <a href="{{ url('sfs_cms_admin_sections_versions', {'section':section.id}) }}" class="btn btn-light mx-1">{{ ('admin_sections.preview.actions.cancel.button')|trans }}</a>
                        {% else %}
                            <a href="{{ url('sfs_cms_admin_sections_details', {'section':section.id}) }}" class="btn btn-light mx-1">{{ ('admin_sections.preview.actions.cancel.button')|trans }}</a>
                        {% endif %}

                        {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_CREATE', version) %}
                            <a href="{{ url('sfs_cms_admin_sections_content_from_version', {'section':section.id, 'prevVersion':version.id}) }}" class="btn btn-light mx-1">{{ ('admin_sections.preview.actions.content.button')|trans }}</a>
                        {% else %}
                            <a class="btn btn-light mx-1 disabled">{{ ('admin_sections.preview.actions.content.button')|trans }}</a>
                        {% endif %}

                        {% if version.published %}
                            <span class="btn btn-light disabled mx-1">{{ ('admin_sections.preview.actions.published.button')|trans }}</span>
                        {% else %}
                            {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_VERSION_PUBLISH', version) %}
                                <a href="{{ url('sfs_cms_admin_sections_publish_version', {'section':section.id, 'version':version.id, 'back':'preview'}) }}" class="btn btn-light mx-1">{{ ('admin_sections.preview.actions.publish.button')|trans }}</a>
                            {% else %}
                                <a class="btn btn-light mx-1 disabled">{{ ('admin_sections.preview.actions.publish.button')|trans }}</a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </header>
        <main class="flex-fill d-flex flex-row align-items-stretch bg-light  min-vh-100">
            <iframe class="h-100 w-100" name="previewFrame" id="preview" src="{{ url('sfs_cms_admin_sections_version_preview', {'section':section.id, 'version':version.id, '_site': sites.first, '_locale': defaultLocale}) }}" width="100%" height="100%"></iframe>
        </main>
    </div>

    {% include '@SfsComponents/flash-messages/alerts.html.twig' %}
{% endblock body %}

