{% import '@SfsCms/macros/modules_render.html.twig' as module %}

{% if section %}
    {% if id|default(false) or class|default(false) %}<div {{ module.id(id) }} {{ module.class(class) }}>{% endif %}
        {% if esi %}
            ESI
            {{ render_esi(controller('Softspring\\CmsBundle\\Controller\\SectionController::renderById', {'section':section.id, '_locale':app.request.locale})) }}
        {% else %}
            NO ESI
            {{ render(url('sfs_cms_section_render', {'section': section.id, '_locale':app.request.locale})) }}
        {% endif %}
    {% if id|default(false) or class|default(false) %}</div>{% endif %}
{% endif %}
