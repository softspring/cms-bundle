{% trans_default_domain 'sfs_cms_admin' %}

{% embed '@SfsCms/admin/_embeds/_card.html.twig' with {'title': ('admin_sections.read.versions.title')|trans} %}
    {% trans_default_domain 'sfs_cms_admin' %}

    {% block title %}
        {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTIONS_VERSIONS', section) %}
            <a class="btn btn-sm btn-outline-secondary float-end"  href="{{ url('sfs_cms_admin_sections_versions', {'section':section.id}) }}">{{ ('admin_sections.read.versions.more.link')|trans }}</a>
        {% else %}
            <a class="btn btn-sm btn-outline-secondary float-end disabled">{{ ('admin_sections.read.versions.more.link')|trans }}</a>
        {% endif %}
        {{ parent() }}
    {% endblock %}

    {% block content %}
        {% include '@SfsCms/admin/section/_version_list_table.html.twig' with {'versions': lastestVersions} %}
    {% endblock %}
{% endembed %}