{% trans_default_domain 'sfs_cms_contents' %}

{% embed '@SfsCms/admin/_embeds/_card.html.twig' with {'title': 'General'} %}
    {% trans_default_domain 'sfs_cms_contents' %}

    {% block title %}
        <h5 class="border-bottom border-1 border-light pb-2 mb-3 d-flex align-items-center justify-content-between gap-2">
            <span>{{ title }}</span>
            {% if content_entity.publishedVersion %}
                {% if not content_config.admin.unpublish.is_granted or is_granted(content_config.admin.unpublish.is_granted, content_entity) %}
                    <a class="btn btn-sm btn-outline-secondary flex-shrink-0" href="{{ url('sfs_cms_admin_content_'~content_type~'_unpublish', {'content':content_entity.id}) }}"
                       data-confirm-modal="{{ ('admin_'~content_type~'.version_unpublish.confirm_message_raw')|trans|base64_encode }}"
                       data-confirm-modal-title="{{ ('admin_'~content_type~'.version_unpublish.confirm_message_title')|trans }}"
                       data-confirm-modal-confirm-button-type="danger"
                    >{{ ('admin_'~content_type~'.read.actions.version_unpublish.link')|trans }} <i class="bi bi-toggle-off"></i></a>
                {% else %}
                    <a class="btn btn-sm btn-outline-secondary flex-shrink-0 disabled">{{ ('admin_'~content_type~'.read.actions.version_unpublish.link')|trans }} <i class="bi bi-toggle-off"></i></a>
                {% endif %}
            {% endif %}
        </h5>
    {% endblock %}

    {% block content %}
        <dl class="mb-0">
            {#<dt class=fw-normal>{{ ('admin_'~content_type~'.read.name')|trans }}</dt>#}
            {#<dd class=fw-bold>{{ content_entity.name }}</dd>#}
            <dt class="fw-normal">{{ ('admin_'~content_type~'.read.sites')|trans }}</dt>
            <dd class="fw-bold">{{ content_entity.sites|map((site) => site|sfs_cms_site_name)|join(', ') }}</dd>
            <dt class="fw-normal">{{ ('admin_'~content_type~'.read.general.status')|trans }}</dt>
            <dd class="fw-bold">
                {{ (content_type~'.status.'~content_entity.status)|trans }}
                {% if content_entity.publishedVersion %}
                    (<a href="{{ url('sfs_cms_admin_content_'~content_type~'_version_info', {'content':content_entity.id, 'version':content_entity.publishedVersion.id}) }}">v{{ content_entity.publishedVersion.versionNumber }}</a>)
                {% endif %}
            </dd>
            {% if content_entity.publishedVersion %}
            <dt class="fw-normal">{{ ('admin_'~content_type~'.read.general.publishDate')|trans }}</dt>
            <dd class="fw-bold">
                {% if content_entity.lastModified %}
                    {{ content_entity.lastModified|date('H:i d-m-Y') }}
                {% endif %}
            </dd>
            {% endif %}
        </dl>
    {% endblock %}
{% endembed %}
