{% use 'bootstrap_5_layout.html.twig' %}

{% block form_row %}
    {%- set row_attr = (row_attr|default({}))|merge({'data-field-container': form.vars.id}) -%}
    {{- parent() -}}
{% endblock form_row %}

{% block form_label %}
    {% set label_attr = label_attr|merge({'class': (label_attr.class|default('') ~ ' text-uppercase small text-body-secondary fw-semibold')|trim}) %}
    {{ parent() }}
{% endblock form_label %}